# Copia este archivo a .env.local (local) y configura las mismas claves en Netlify.
# Nunca subas valores reales al repositorio.

# Supabase (Project settings → API). Clave publicable: segura en el navegador porque la RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio (para enlaces de confirmación e invitaciones)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gala IA (Anthropic). Solo en el servidor.
ANTHROPIC_API_KEY=
# Opcional: modelo (por defecto claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Datos oficiales de universidades: College Scorecard (U.S. Dept. of Education). Clave gratuita en https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=

# Sal para el hash de IP en los registros de consentimiento de cookies (valor aleatorio largo)
CONSENT_IP_SALT=

# Pagos automáticos (Stripe Checkout). Sin estas claves, los planes se solicitan en lugar de pagarse.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Clave secreta de Supabase: SOLO la usa el webhook de Stripe para conceder planes. Nunca NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Captcha (Cloudflare Turnstile). Opcional: sin ella no se muestra el captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Correo (Resend). Sin estas dos no se envía ningún correo y la app lo dice (no finge envíos).
RESEND_API_KEY=
EMAIL_FROM=
# Lista de difusión: a quién avisar cuando una organización responde, a dónde contestan y con qué nombre se firma.
OUTREACH_NOTIFY_EMAIL=
OUTREACH_REPLY_TO=
OUTREACH_SENDER_NAME=Gala
